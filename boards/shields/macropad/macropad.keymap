// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        profile_mode: profile_mode {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            display-name = "Profile selection timeout";
            release-after-ms = <2000>;
            bindings = <&mo>;
            quick-release;
        };

        profile_controls: profile_controls {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            // Combo timestamps start at the first press; allow its 100 ms window.
            tapping-term-ms = <3100>;
            flavor = "tap-preferred";
            bindings = <&forget_selected>, <&open_profiles>;
        };
    };

    macros {
        open_profiles: open_profiles {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Open Bluetooth profiles";
            wait-ms = <0>;
            tap-ms = <0>;
            // Queue activation so the selection timeout starts on combo release.
            bindings = <&profile_mode 1>;
        };

        select_profile: select_profile {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            display-name = "Select Bluetooth profile";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_param_1to2 &bt BT_SEL 0>, <&to 0>;
        };

        forget_selected: forget_selected {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Forget selected Bluetooth profile";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&bt BT_CLR>, <&to 0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        studio_unlock_combo {
            timeout-ms = <50>;
            key-positions = <0 8>;
            bindings = <&studio_unlock>;
        };

        profile_controls_combo {
            timeout-ms = <100>;
            key-positions = <3 4 5>;
            bindings = <&profile_controls 0 0>;
        };
    };

    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Controls";
            bindings = <
                &kp F13 &kp F14 &kp F15
                &kp F16 &kp F17 &kp F18
                &kp F19 &kp F20 &kp F21
            >;
        };

        profile_selection_layer {
            display-name = "Bluetooth profiles";
            bindings = <
                &select_profile 0 &select_profile 1 &select_profile 2
                &to 0            &to 0            &to 0
                &to 0            &to 0            &to 0
            >;
        };
    };
};
